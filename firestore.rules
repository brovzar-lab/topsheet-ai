rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All user data is scoped under their UID.
    // Only the authenticated user can read or write their own data.
    // Sub-collections (projects, breakdowns, budgets, schedules) are covered
    // by the {document=**} wildcard.
    match /users/{uid}/{document=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Explicit deny for any path not matched above.
    // This is the default Firestore behaviour, but making it explicit
    // communicates intent clearly and guards against future rule additions
    // that might accidentally broaden access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
